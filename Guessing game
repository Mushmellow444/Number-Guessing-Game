import random
attempts = 10
max_number = 50
print ("Welcome to the number guessing game!")
print ("please select a mode:")
print ("1. Easy")
print ("2. Medium")
print ("3. Hard")
mode = int(input("Enter your choice:"))
if mode == 1:
    max_number = 20
elif mode == 2:
    max_number = 50
elif mode == 3:
    max_number = 100
else: 
    print ("Invalid choice! Defaulting to Medium mode.")
    max_number = 50
random_number = random.randint(1, max_number)
while attempts > 0:
    print ("Guess a number between 1-", max_number)
    x_guess = int(input("Enter your guess:"))
    if random_number == x_guess:
        print("Congrats you win!")
        print ("Play again? (y/n)")
        input_choice = input()
        if input_choice.lower() == "y":
            attempts = 10
            random_number = random.randint(1, max_number)
            continue
        elif input_choice.lower() == "n":
            print ("Thanks for playing!")
            break
    if x_guess < 1 or x_guess > max_number:
        print ("Please enter a number between 1-", max_number)
        continue
    elif x_guess > random_number and x_guess <= max_number:
        print ("Too high! Try again!")
    elif x_guess < random_number and x_guess >= 1:
        print ("Too low! Try again!")
    attempts -= 1
    print("Attempts =", attempts)
    if attempts == 0:
        print ("You have run out of attempts! The number was", random_number)
        print ("Play again? (y/n)")
        input_choice = input()
        if input_choice.lower() == "y":
            attempts = 10
            random_number = random.randint(1, max_number)
            continue
        elif input_choice.lower() == "n":
            print ("Thanks for playing!")
            break
